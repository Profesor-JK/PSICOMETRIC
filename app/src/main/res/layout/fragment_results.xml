                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="1"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>