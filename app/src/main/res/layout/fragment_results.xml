                                android:textColor="@color/Carbon"/>
                        </TableRow>
                        <TableRow
                            android:padding="8dp">
                            <TextView
                                android:text="15"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="8"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="3"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="2"
