                        <TableRow
                            android:padding="8dp">
                            <TextView
                                android:text="12"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="8"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="2"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="1"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="1"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="0"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                        </TableRow>
                        <TableRow
                            android:padding="8dp">
                            <TextView
                                android:text="13"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="8"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="3"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="1"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="1"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="0"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                        </TableRow>
                        <TableRow
                            android:padding="8dp">
                            <TextView
                                android:text="14"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
