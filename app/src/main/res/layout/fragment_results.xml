                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="1"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="1"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                            <TextView
                                android:text="0"
                                android:padding="8dp"
                                android:textColor="@color/Carbon"/>
                        </TableRow>
                        <TableRow
                            android:padding="8dp">
                            <TextView
                                android:text="11"
